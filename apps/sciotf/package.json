{
  "name": "@4bitlabs/sciotf",
  "version": "1.0.1",
  "description": "A CLI utility to convert SCI0/SCI01 fonts into OTF fonts",
  "keywords": [
    "sci0",
    "sierra on-line",
    "sci01",
    "fonts",
    "otf"
  ],
  "license": "ISC",
  "author": "J. Holmes <32bitkid@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/main.d.mts",
      "import": "./dist/main.mjs"
    }
  },
  "bin": {
    "sciotf": "./dist/main.mjs"
  },
  "files": [
    "./dist/**/*"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "tsc --build --clean",
    "clean:wipe": "rimraf ./dist",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:dev": "vitest dev"
  },
  "dependencies": {
    "@4bitlabs/sci0": "^6.1.2",
    "@watercolorizer/tracer": "^3.2.1",
    "opentype.js": "^2.0.0",
    "sade": "^1.8.1",
    "transformation-matrix": "^3.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.11.0",
    "@types/opentype.js": "^1.3.10"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
