{
  "name": "@4bitlabs/sciotf",
  "version": "0.0.0",
  "description": "A CLI utility to convert SCI0/SCI01 fonts into TTF files",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.mts"
    }
  },
  "bin": {
    "sciotf": "./dist/main.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "tsc --build --clean",
    "clean:wipe": "rimraf ./dist",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:dev": "vitest dev"
  },
  "dependencies": {
    "@4bitlabs/sci0": "^6.1.2",
    "@watercolorizer/tracer": "^3.2.1",
    "opentype.js": "^2.0.0",
    "sade": "^1.8.1",
    "zod": "^4.4.3",
    "transformation-matrix": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.11.0",
    "@types/opentype.js": "^1.3.10"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}